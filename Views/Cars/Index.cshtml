@model IEnumerable<Homework___4.Models.Car>

@{
	ViewData["Title"] = "Available Cars";
}

<div class="container my-4">
    <h2 class="mb-2">Available Cars</h2>
    <p class="text-muted mb-4">Please select a car to proceed with your booking.</p>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center" role="alert">
            No cars are currently available for booking.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var car in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h4 class="card-title mb-0">@car.Name</h4>
                                    <span class="badge bg-success">Available</span>
                                </div>
                                <p class="card-text fs-5 fw-bold text-primary mb-4">
                                    PKR @car.PricePerDay.ToString("N0") <span class="fs-6 text-muted fw-normal">/ day</span>
                                </p>
                            </div>
                            <form asp-controller="Cars" asp-action="Book" method="post" class="mt-auto">
                                <input type="hidden" name="id" value="@car.Id" />
                                <button type="submit" class="btn btn-primary w-100">Book Car</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>